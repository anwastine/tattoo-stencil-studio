# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead.

# --- image model ---
OPENAI_API_KEY=sk-...

# --- Google sign-in ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- database (Vercel → Storage → Neon injects this automatically) ---
DATABASE_URL=postgres://...

# --- payments (Razorpay) ---
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
# Optional but recommended: set the same value in the Razorpay webhook settings
RAZORPAY_WEBHOOK_SECRET=
